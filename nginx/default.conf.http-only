# Bootstrap config used ONLY to obtain the first Let's Encrypt certificate.
# Serves the app over plain HTTP and exposes the ACME webroot challenge path.
# Once certbot has issued a certificate, replace this file's contents with
# default.conf (the TLS-enabled version) and reload nginx.

server {
    listen 80;
    server_name YOUR_DOMAIN_HERE;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /static/ {
        alias /app/staticfiles/;
    }

    location /media/ {
        alias /app/media/;
    }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
