# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev defaults to sqlite if unset. In production, point at Neon:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# DATABASE_URL=

TIME_ZONE=Africa/Kampala

CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Emailing quotations/invoices/receipts, staff invites and password resets.
# All of it is hidden until EMAIL_ENABLED=True (off by default, because production
# has no working mail provider yet). With it on and no provider below, mail is
# printed to the console instead of sent (fine for local dev).
# EMAIL_ENABLED=True
#
# Production (Railway blocks SMTP on trial/hobby plans): send through Brevo's API.
# Create an API key in Brevo (SMTP & API -> API keys) and verify the sender domain.
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=Pretty Events <info@prettyeventslimited.co.ug>
#
# Or plain SMTP where the host allows it:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=prettyevents5@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=prettyevents5@gmail.com

# Background emails. Leave off unless a worker process is running too
# (Railway: a second service with start command `./entrypoint.sh worker`;
# docker-compose: the `worker` service). With it on, "Email to client" returns
# straight away and the worker sends the PDF.
# TASK_WORKER_ENABLED=True

# How many days a document link in a WhatsApp message keeps working.
# SHARE_LINK_DAYS=30

# Uploaded files (S3 or Cloudflare R2). Needed before adding any uploads on
# Railway, whose disk is wiped on every deploy. Unset = local media/ folder.
# MEDIA_BUCKET=pretty-events-media
# R2 only (leave unset for AWS S3):
# MEDIA_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_REGION=auto

# Mobile money webhook (MTN / Airtel or an aggregator). Unset = endpoint off.
# The provider signs each callback with this secret (HMAC-SHA256 in X-Signature)
# and posts to https://<your-domain>/billing/mobile-money/webhook/<provider>/
# MOBILE_MONEY_WEBHOOK_SECRET=
