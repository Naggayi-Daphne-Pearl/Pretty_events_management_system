# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev defaults to sqlite if unset. In production, point at Neon:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# DATABASE_URL=

TIME_ZONE=Africa/Kampala

CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Emailing quotations/invoices to clients. Left unset, mail is printed to the
# console instead of sent — fine for local dev. For real sending (e.g. Gmail
# with an app password), uncomment and fill these in:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=prettyevents5@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=prettyevents5@gmail.com
