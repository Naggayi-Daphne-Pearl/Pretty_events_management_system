# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev defaults to sqlite if unset. In production, point at Neon:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# DATABASE_URL=

TIME_ZONE=Africa/Kampala

CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Emailing quotations/invoices/receipts, staff invites and password resets.
# All of it is hidden until EMAIL_ENABLED=True (off by default, because production
# has no working mail provider yet). With it on and no provider below, mail is
# printed to the console instead of sent (fine for local dev).
# EMAIL_ENABLED=True
#
# Production (Railway blocks SMTP on trial/hobby plans): send through Brevo's API.
# Create an API key in Brevo (SMTP & API -> API keys) and verify the sender domain.
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=Pretty Events <info@prettyeventslimited.co.ug>
#
# Or plain SMTP where the host allows it:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=prettyevents5@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=prettyevents5@gmail.com
